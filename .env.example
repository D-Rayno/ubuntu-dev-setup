# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values to run the installer fully
# non-interactively (./install.sh --non-interactive). Any value left unset
# falls back to a sensible default or an interactive prompt.
#
#   cp .env.example .env
#   nano .env
#   ./install.sh --non-interactive
# =============================================================================

# --- Git identity -------------------------------------------------------
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"
GIT_DEFAULT_BRANCH="main"
GIT_CREDENTIAL_HELPER="store"          # store | cache | manager | none
GIT_ENABLE_SSH_SIGNING="false"         # true | false
GIT_SIGNING_KEY_PATH="~/.ssh/id_ed25519.pub"

# --- SSH ------------------------------------------------------------------
# Only relevant if you actually have an old SSH key backup to restore. If you
# don't, leave these alone — the installer will generate a fresh key instead.
# SSH_RESTORE_FROM_BACKUP="false"      # true | false — skips the prompt
SSH_BACKUP_DIR="~/Backup/ssh"
# SSH_KEYGEN_EMAIL="you@example.com"   # used only when generating a new key

# --- Database credentials (local development only) --------------------------
# NOTE: these are also defined in config/versions.conf; set them here to
# override without editing tracked config files.
# MYSQL_DEV_USER="devuser"
# MYSQL_DEV_PASSWORD="devpassword"
# MYSQL_DEV_DATABASE="devdb"
# POSTGRES_DEV_USER="devuser"
# POSTGRES_DEV_PASSWORD="devpassword"
# POSTGRES_DEV_DATABASE="devdb"

# --- NVIDIA -----------------------------------------------------------------
# ask | yes | no
# INSTALL_NVIDIA_DRIVER="ask"
# INSTALL_CUDA_TOOLKIT="ask"

# --- Behavior flags -----------------------------------------------------
# VERBOSE=1
# NON_INTERACTIVE=1
